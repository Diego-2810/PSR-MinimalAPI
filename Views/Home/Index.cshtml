@*
    ==========================================================================
    PSR-MinimalAPI - Vista de Landing Page Pizzería Artesanal
    Archivo: Views/Home/Index.cshtml
    Compatible con ASP.NET Core MVC / Razor Engine
    ==========================================================================
*@

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Pizzería PSR - Las mejores pizzas artesanales";
}

<!-- Enlace al CSS personalizado de la Landing (en wwwroot/css/landing.css) -->
<link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

<div class="pizza-landing-body">
    
    <!-- ==========================================================================
         1. SECCIÓN HERO (Encabezado Principal a Pantalla Completa / Gran Tamaño)
         ========================================================================== -->
    <section class="hero-section">
        <!-- Efectos de luz y gradientes de fondo -->
        <div class="hero-background-shapes">
            <div class="hero-bg-glow"></div>
        </div>

        <div class="pizza-landing-container">
            <div class="hero-grid">
                
                <!-- Columna Izquierda: Texto Persuasivo & Call To Action -->
                <div class="hero-content">
                    <div class="hero-badge-container">
                        <span class="hero-badge">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
                            </svg>
                            Tradición & Sabor Napolitano
                        </span>
                    </div>

                    <h1 class="hero-title">
                        Las mejores pizzas artesanales, <span class="hero-title-highlight">directas a tu casa</span>
                    </h1>

                    <p class="hero-subtitle">
                        Masa madre fermentada lentamente durante 48 horas, salsa de tomates San Marzano importados y horneadas a 450°C en nuestro auténtico horno de barro a leña.
                    </p>

                    <!-- Botones de Acción utilizando Tag Helpers de ASP.NET Core MVC -->
                    <div class="hero-actions">
                        <a asp-controller="Pedido" asp-action="Crear" class="btn-cta-giant" id="btn-pedir-ahora">
                            Pedir Ahora
                            <span class="btn-cta-icon" aria-hidden="true">🍕</span>
                        </a>

                        <a asp-controller="Menu" asp-action="Index" class="btn-secondary-custom">
                            Ver Menú Completo
                        </a>
                    </div>

                    <!-- Indicadores de confianza -->
                    <div class="hero-proof">
                        <div class="proof-item">
                            <span class="proof-number">48hs</span>
                            <span class="proof-label">Fermentación natural</span>
                        </div>
                        <div class="proof-item">
                            <span class="proof-number">450°C</span>
                            <span class="proof-label">Horno de barro</span>
                        </div>
                        <div class="proof-item">
                            <span class="proof-number">★ 4.9/5</span>
                            <span class="proof-label">+15.000 clientes felices</span>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Ilustración Visual & Badges Flotantes -->
                <div class="hero-visual-wrapper">
                    <div class="hero-art-container">
                        <div class="pizza-glow-ring"></div>

                        <!-- Badge Flotante 1: 100% Masa Madre -->
                        <div class="floating-badge badge-top-left">
                            <div class="badge-icon">🌾</div>
                            <div>
                                <div class="badge-text-primary">100% Masa Madre</div>
                                <div class="badge-text-secondary">Sin aditivos ni conservantes</div>
                            </div>
                        </div>

                        <!-- Tarjeta Ilustrativa de la Pizza -->
                        <div class="pizza-illustration-card">
                            <svg class="pizza-svg-art" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <!-- Base Crust -->
                                <circle cx="250" cy="250" r="210" fill="#C87533" stroke="#8C4611" stroke-width="12"/>
                                <circle cx="250" cy="250" r="185" fill="#E69547"/>
                                <!-- Tomato Sauce -->
                                <circle cx="250" cy="250" r="170" fill="#D9381E"/>
                                <!-- Mozzarella Melt -->
                                <path d="M 140 200 C 180 150, 320 150, 360 200 C 390 250, 370 320, 340 350 C 290 390, 190 390, 150 340 C 120 290, 110 240, 140 200 Z" fill="#FFF8EE"/>
                                <circle cx="200" cy="180" r="35" fill="#FFF3DF"/>
                                <circle cx="300" cy="210" r="45" fill="#FFF3DF"/>
                                <circle cx="230" cy="300" r="40" fill="#FFF3DF"/>
                                <!-- Pepperoni Slices -->
                                <circle cx="190" cy="220" r="25" fill="#B22222" stroke="#8B0000" stroke-width="3"/>
                                <circle cx="280" cy="170" r="28" fill="#B22222" stroke="#8B0000" stroke-width="3"/>
                                <circle cx="330" cy="270" r="26" fill="#B22222" stroke="#8B0000" stroke-width="3"/>
                                <circle cx="220" cy="330" r="27" fill="#B22222" stroke="#8B0000" stroke-width="3"/>
                                <circle cx="150" cy="290" r="22" fill="#B22222" stroke="#8B0000" stroke-width="3"/>
                                <!-- Basil Leaves -->
                                <path d="M 240 220 Q 260 200 270 220 Q 250 240 240 220 Z" fill="#2E7D32"/>
                                <path d="M 180 300 Q 200 280 210 300 Q 190 320 180 300 Z" fill="#388E3C"/>
                                <path d="M 310 320 Q 330 300 340 320 Q 320 340 310 320 Z" fill="#2E7D32"/>
                            </svg>
                        </div>

                        <!-- Badge Flotante 2: Envío Térmico -->
                        <div class="floating-badge badge-bottom-right">
                            <div class="badge-icon">🛵</div>
                            <div>
                                <div class="badge-text-primary">Llega Caliente</div>
                                <div class="badge-text-secondary">Entrega prom. 25-35 min</div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================================================
         2. SECCIÓN DE DESTACADOS (Features / Pilares del Negocio)
         ========================================================================== -->
    <section class="features-section" id="pilares">
        <div class="pizza-landing-container">
            
            <div class="section-header">
                <span class="section-tag">Nuestra Promesa</span>
                <h2 class="section-title">¿Por qué nuestras pizzas son inigualables?</h2>
            </div>

            <div class="features-grid">
                
                <!-- Tarjeta 1: Ingredientes Frescos -->
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <!-- Icono SVG: Hoja / Ingredientes Frescos -->
                        <svg class="feature-icon-svg" viewBox="0 0 24 24">
                            <path d="M17,8C14,8 10,10.5 8.5,14C8.5,14 6.5,11.5 4,11.5C2.5,11.5 1,12.5 1,14C1,17 4,20 8,20C13,20 17,16 17,11.5C17,10.3 17,8 17,8M8,18C5.5,18 3,16 3,14C3,13.8 3.3,13.5 4,13.5C5.5,13.5 7.5,15.5 8,16.5C8.3,15 9.8,12.7 12,11.2C13.8,10 15.3,9.6 15.5,9.6C15.4,10.7 14.5,13 12.5,15C10.5,17 8.8,17.9 8,18Z"/>
                        </svg>
                    </div>
                    <h3 class="feature-card-title">Ingredientes Frescos</h3>
                    <p class="feature-card-desc">
                        Utilizamos tomates de lata San Marzano D.O.P., queso fior di latte recién elaborado y vegetales orgánicos seleccionados día a día de productores locales.
                    </p>
                </div>

                <!-- Tarjeta 2: Horno de Barro -->
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <!-- Icono SVG: Fuego / Horno de Barro -->
                        <svg class="feature-icon-svg" viewBox="0 0 24 24">
                            <path d="M12,11.5A2.5,2.5 0 0,1 14.5,14A2.5,2.5 0 0,1 12,16.5A2.5,2.5 0 0,1 9.5,14A2.5,2.5 0 0,1 12,11.5M12,2C12,2 15,5 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8C9,5 12,2 12,2M17.5,10.5C17.5,10.5 20,13 20,15.5A4.5,4.5 0 0,1 15.5,20A4.5,4.5 0 0,1 11,15.5C11,14.2 11.5,13 12.5,12C11,12 8,13.5 8,17A6,6 0 0,0 14,23A6,6 0 0,0 20,17C20,14 17.5,10.5 17.5,10.5Z"/>
                        </svg>
                    </div>
                    <h3 class="feature-card-title">Horno de Barro</h3>
                    <p class="feature-card-desc">
                        Cocción napolitana auténtica a más de 450°C sobre piedra refractaria y leña de quebracho seco, logrando el icónico cornicione aireado y crocante.
                    </p>
                </div>

                <!-- Tarjeta 3: Delivery Veloz -->
                <div class="feature-card">
                    <div class="feature-icon-wrapper">
                        <!-- Icono SVG: Moto / Delivery Veloz -->
                        <svg class="feature-icon-svg" viewBox="0 0 24 24">
                            <path d="M19,7H16V5H19A2,2 0 0,1 21,7V15H19A3,3 0 0,1 16,18A3,3 0 0,1 13,15H9A3,3 0 0,1 6,18A3,3 0 0,1 3,15H1V11L3.5,6H11V8H4.7L3.1,11H9V13H4.1A3,3 0 0,1 6,14A3,3 0 0,1 7.9,13H14.1A3,3 0 0,1 16,14A3,3 0 0,1 17.9,13H19V7M6,15A1,1 0 0,0 7,16A1,1 0 0,0 8,15A1,1 0 0,0 7,14A1,1 0 0,0 6,15M16,15A1,1 0 0,0 17,16A1,1 0 0,0 18,15A1,1 0 0,0 17,14A1,1 0 0,0 16,15M13,3H15V6H13V3Z"/>
                        </svg>
                    </div>
                    <h3 class="feature-card-title">Delivery Veloz</h3>
                    <p class="feature-card-desc">
                        Bolsas térmicas rígidas diseñadas especialmente para preservar el vapor, la temperatura ideal y el queso fundido crocante en menos de 30 minutos.
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- ==========================================================================
         3. SECCIÓN DESTACADOS DEL MENÚ (Visual Extra Premium)
         ========================================================================== -->
    <section class="promo-banner-section">
        <div class="pizza-landing-container">
            <div class="promo-grid">
                <div class="promo-content">
                    <span class="section-tag">Las Favoritas del Público</span>
                    <h2 class="promo-title">Descubrí las pizzas más pedidas de la semana</h2>
                    <p class="promo-desc">
                        Elegí tu favorita y disfrutala en minutos con seguimiento en tiempo real de tu pedido.
                    </p>
                    <a asp-controller="Pedido" asp-action="Crear" class="btn-cta-giant">
                        Pedir Ahora
                    </a>
                </div>

                <div class="promo-cards-wrapper">
                    <div class="mini-pizza-card">
                        <div class="mini-card-title">Margarita Napolitana</div>
                        <p style="font-size:0.85rem; color:#A89B93; margin-bottom:0.75rem;">Tomate San Marzano, Fior di Latte, Albahaca fresca</p>
                        <div class="mini-card-price">$8.500</div>
                    </div>
                    <div class="mini-pizza-card">
                        <div class="mini-card-title">Pepperoni Supremo</div>
                        <p style="font-size:0.85rem; color:#A89B93; margin-bottom:0.75rem;">Double Pepperoni crocante, Miel picante ahumada</p>
                        <div class="mini-card-price">$9.800</div>
                    </div>
                    <div class="mini-pizza-card">
                        <div class="mini-card-title">Cuatro Quesos Gourmet</div>
                        <p style="font-size:0.85rem; color:#A89B93; margin-bottom:0.75rem;">Mozzarella, Gorgonzola, Provolone, Parmesano 24 meses</p>
                        <div class="mini-card-price">$10.200</div>
                    </div>
                    <div class="mini-pizza-card">
                        <div class="mini-card-title">Fugazzeta Rellena</div>
                        <p style="font-size:0.85rem; color:#A89B93; margin-bottom:0.75rem;">Rellena de mozzarella fundida con cebollas caramelizadas</p>
                        <div class="mini-card-price">$9.500</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ==========================================================================
         4. FOOTER BÁSICO (Para integrarse limpiamente con _Layout.cshtml)
         ========================================================================== -->
    <footer class="pizza-footer">
        <div class="pizza-landing-container">
            <div class="footer-top-grid">
                
                <!-- Columna 1: Branding -->
                <div>
                    <div class="footer-brand-title">
                        <span>🍕</span> Pizzería PSR
                    </div>
                    <p class="footer-brand-desc">
                        Pasión por la pizza artesanal horneada a la leña. Innovación en gestión de pedidos rápidos para una experiencia gastronómica sin demoras.
                    </p>
                    <div class="social-links">
                        <a href="https://instagram.com" target="_blank" class="social-btn" aria-label="Instagram">
                            <svg viewBox="0 0 24 24"><path d="M12,2.163c3.204,0,3.584,0.012,4.85,0.07c3.252,0.148,4.771,1.691,4.919,4.919c0.058,1.265,0.069,1.645,0.069,4.849c0,3.205-0.012,3.584-0.069,4.849c-0.149,3.225-1.664,4.771-4.919,4.919c-1.266,0.058-1.644,0.07-4.85,0.07c-3.204,0-3.584-0.012-4.849-0.07c-3.26-0.149-4.771-1.699-4.919-4.92c-0.058-1.265-0.07-1.644-0.07-4.849c0-3.204,0.013-3.583,0.07-4.849c0.149-3.227,1.664-4.771,4.919-4.919c1.266-0.057,1.645-0.069,4.849-0.069 M12,0C8.741,0,8.333,0.014,7.053,0.072C2.695,0.272,0.273,2.69,0.073,7.052C0.014,8.333,0,8.741,0,12c0,3.259,0.014,3.668,0.072,4.948c0.2,4.358,2.618,6.78,6.98,6.98C8.333,23.986,8.741,24,12,24c3.259,0,3.668-0.014,4.948-0.072c4.354-0.2,6.782-2.618,6.979-6.98C23.986,15.668,24,15.259,24,12c0-3.259-0.014-3.667-0.072-4.947c-0.196-4.354-2.617-6.78-6.979-6.98C15.668,0.014,15.259,0,12,0z M12,5.838c-3.403,0-6.162,2.759-6.162,6.162c0,3.403,2.759,6.163,6.162,6.163c3.403,0,6.163-2.759,6.163-6.163C18.163,8.597,15.403,5.838,12,5.838z M12,16c-2.209,0-4-1.79-4-4c0-2.209,1.791-4,4-4c2.209,0,4,1.791,4,4C16,14.21,14.209,16,12,16z M18.406,4.155c-0.796,0-1.441,0.645-1.441,1.44s0.645,1.44,1.441,1.44c0.795,0,1.439-0.645,1.439-1.44S19.201,4.155,18.406,4.155z"/></svg>
                        </a>
                        <a href="https://facebook.com" target="_blank" class="social-btn" aria-label="Facebook">
                            <svg viewBox="0 0 24 24"><path d="M24,12.073c0-6.627-5.373-12-12-12s-12,5.373-12,12c0,5.99,4.388,10.954,10.125,11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007,1.792-4.669,4.533-4.669c1.312,0,2.686,0.235,2.686,0.235v2.953H15.83c-1.491,0-1.956,0.925-1.956,1.874v2.25h3.328l-0.532,3.47h-2.796v8.385C19.612,23.027,24,18.062,24,12.073z"/></svg>
                        </a>
                        <a href="https://whatsapp.com" target="_blank" class="social-btn" aria-label="WhatsApp">
                            <svg viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                        </a>
                    </div>
                </div>

                <!-- Columna 2: Navegación Rápida con Tag Helpers -->
                <div>
                    <h3 class="footer-column-title">Navegación</h3>
                    <ul class="footer-links">
                        <li>
                            <a asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li>
                            <a asp-controller="Menu" asp-action="Index">Menú & Carta</a>
                        </li>
                        <li>
                            <a asp-controller="Pedido" asp-action="Crear">Hacer Pedido</a>
                        </li>
                        <li>
                            <a asp-controller="Pedido" asp-action="Seguimiento">Seguimiento en Vivo</a>
                        </li>
                    </ul>
                </div>

                <!-- Columna 3: Horarios -->
                <div>
                    <h3 class="footer-column-title">Horarios</h3>
                    <ul class="footer-links">
                        <li style="color:#C2B7B1; font-size:0.95rem;">
                            <strong>Lunes a Viernes:</strong><br/>19:00 - 00:00 hs
                        </li>
                        <li style="color:#C2B7B1; font-size:0.95rem; margin-top:0.75rem;">
                            <strong>Sábados y Domingos:</strong><br/>19:00 - 01:00 hs
                        </li>
                    </ul>
                </div>

                <!-- Columna 4: Contacto y Ubicación -->
                <div>
                    <h3 class="footer-column-title">Contacto</h3>
                    <ul class="footer-contact-info">
                        <li class="footer-contact-item">
                            <span class="footer-contact-icon">📍</span>
                            <span>Av. Corrientes 1234, CABA, Argentina</span>
                        </li>
                        <li class="footer-contact-item">
                            <span class="footer-contact-icon">📞</span>
                            <span>+54 11 4567-8900</span>
                        </li>
                        <li class="footer-contact-item">
                            <span class="footer-contact-icon">✉️</span>
                            <span>contacto@pizzeriapsr.com</span>
                        </li>
                    </ul>
                </div>

            </div>

            <!-- Footer Créditos y Copyright -->
            <div class="footer-bottom">
                <div>
                    &copy; @DateTime.Now.Year Pizzería PSR - Todos los derechos reservados.
                </div>
                <div>
                    Desarrollado para <strong>PSR-MinimalAPI</strong> | ASP.NET Core MVC
                </div>
            </div>
        </div>
    </footer>

</div>
